# Postgres (docker-compose: utente/password/db "ailiteracy")
DATABASE_URL=postgresql://ailiteracy:ailiteracy@localhost:5432/ailiteracy?schema=public

# Server
PORT=4000
# Se dietro reverse proxy / ingress: true per leggere l'IP reale (throttling)
TRUST_PROXY=false

# Chiave condivisa con il front-end (header X-Api-Key). Genera: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# SMTP (turbo-smtp). In test usare SMTP_HOST=json per non inviare nulla.
SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Generazione Ai <hello@generazioneai.it>"
MAIL_REPLY_TO=hello@generazioneai.it

# URL pubblico della landing (per i link nelle email)
FRONTEND_URL=http://localhost:3000

# Conservazione lead in mesi (come dichiarato nell'informativa). 0 = nessuna cancellazione automatica
RETENTION_MONTHS=24

# Opzionali
# Copia interna per ogni lead (vuoto = disattivata)
LEAD_NOTIFY_TO=
# Percentuale di sconto mostrata in email/PDF (vuoto = non menzionata)
DISCOUNT_PERCENT=
